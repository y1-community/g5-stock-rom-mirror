{
  "source_repo": "y1-community/g5-stock-rom",
  "mirror_repo": "y1-community/g5-stock-rom-mirror",
  "branch": "main",
  "updater_repo": "y1-community/updater-ce-neo",
  "post_install": [],
  "title_prefix": "Portable Flashing Package: ",
  "copy_original_assets": true,
  "source_readme": {
    "enabled": true,
    "path": "README.md",
    "commit_message": "Mirror source README"
  },
  "build_workers": 2,
  "max_asset_bytes": 2147483648,
  "releases": {
    "include_prereleases": true,
    "tags": [],
    "exclude_tags": []
  },
  "defaults": {
    "software_name": "Original Software",
    "target_model": "G5",
    "target_type": "Stock",
    "description": ""
  },
  "rules": [
    {
      "match_asset": "(?i)360p",
      "target_type": "360p"
    },
    {
      "match_asset": "(?i)240p",
      "target_type": "240p"
    },
    {
      "match_asset": "(?i)rom_y1_type[-_ ]?a",
      "target_model": "Y1",
      "target_type": "Type A"
    },
    {
      "match_asset": "(?i)rom_y1_type[-_ ]?b",
      "target_model": "Y1",
      "target_type": "Type B"
    },
    {
      "match_asset": "(?i)type[-_ ]?b",
      "target_model": "G5",
      "target_type": "Type B"
    },
    {
      "match_asset": "(?i)(^|[-_.])y2([-_.]|$)",
      "target_model": "Y2",
      "target_type": "Stock"
    }
  ],
  "platforms": {
    "windows": {
      "updater_asset": "flash_tool_windows.zip",
      "updater_repo": "y1-community/innioasis-updater",
      "tag": "flash_tool",
      "driver_asset": "1.Install.Driver.First.and.Reboot.PC.exe",
      "suffix": "-windows.zip",
      "layout": "sp_flash_tool",
      "os": "windows",
      "arch": "x86-64"
    },
    "windows-legacy": {
      "updater_asset": "flash_tool_windows.zip",
      "updater_repo": "y1-community/innioasis-updater",
      "tag": "flash_tool",
      "driver_asset": "1.Install.Driver.First.and.Reboot.PC.exe",
      "suffix": "-windows-legacy.zip",
      "layout": "sp_flash_tool",
      "os": "windows",
      "arch": "x86",
      "legacy": true
    },
    "linux": {
      "updater_asset": "flash_tool_linux.zip",
      "updater_repo": "y1-community/innioasis-updater",
      "tag": "flash_tool",
      "suffix": "-linux.zip",
      "layout": "sp_flash_tool",
      "os": "linux",
      "arch": "x86-64"
    },
    "linux-arm64": {
      "updater_asset": "UpdaterCE-Linux-Portable-arm64.zip",
      "suffix": "-linux-arm64.zip",
      "layout": "sp_flash_tool",
      "os": "linux",
      "arch": "arm64",
      "optional": true
    },
    "linux-legacy": {
      "updater_asset": "flash_tool_linux.zip",
      "updater_repo": "y1-community/innioasis-updater",
      "tag": "flash_tool",
      "suffix": "-linux-legacy.zip",
      "layout": "sp_flash_tool",
      "os": "linux",
      "arch": "x86",
      "legacy": true
    },
    "macos": {
      "updater_asset": "Innioasis.Updater.for.Mac.dmg",
      "updater_repo": "y1-community/innioasis-updater",
      "suffix": "-macos.zip",
      "layout": "beside_dmg",
      "os": "macos",
      "arch": "universal"
    }
  }
}
